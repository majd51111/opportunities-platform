# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set this to https://www.gitopp.com in Vercel Production.

# Auth (wire up when implementing authentication)
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# Supabase (set values in .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Automatic opportunity translations (server-only)
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-flash-lite-latest
GEMINI_IMPORT_MODEL=gemini-flash-lite-latest
